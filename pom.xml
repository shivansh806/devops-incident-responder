<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.shivansh</groupId>
    <artifactId>devops-incident-responder</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>devops-incident-responder</name>
    <description>Multi-Agent DevOps Incident Responder</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Core library and the Spring starters are versioned separately upstream. -->
        <langchain4j.version>1.18.1</langchain4j.version>
        <langchain4j-spring.version>1.18.1-beta28</langchain4j-spring.version>
        <!--
            Matches langchain4j-spring.version today because the in-process embedding models
            happen to ride the same beta line. Kept as its own property because that is a
            release-cadence coincidence, not a guarantee, and bumping one should not silently
            drag the other.
        -->
        <langchain4j-embeddings.version>1.18.1-beta28</langchain4j-embeddings.version>
        <spring-dotenv.version>5.1.0</spring-dotenv.version>
        <!-- Overridable so the llm-tagged baseline can be run on demand; see surefire below. -->
        <surefire.excludedGroups>llm</surefire.excludedGroups>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>

        <!--
            Kafka ingestion (week 3). Version comes from the Boot parent, like the starters
            above - spring-kafka is managed there even though it is not a starter artifact.
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!--
            Redis, for caching Analyzer responses (week 3 step 3). The motivation is quota,
            not latency: one Analyzer call is 5,121 measured tokens against 100,000 a day.
            Lettuce comes with the starter and is the client Spring Boot autoconfigures.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai-spring-boot-starter</artifactId>
            <version>${langchain4j-spring.version}</version>
        </dependency>

        <!--
            AI Services (AiServices, @SystemMessage, @UserMessage) live here, not in
            langchain4j-core. The OpenAI starter only pulls core, so declaring agents as
            annotated interfaces needs this module explicitly.
        -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>

        <!--
            all-MiniLM-L6-v2 as an ONNX model that runs inside this JVM: no embeddings API,
            no key, no quota, and tests that touch it stay offline. Groq serves no embeddings
            endpoint at all, so a hosted model would have meant a fourth credential from a
            fourth provider.

            Be aware of the weight before adding more of these. The artifact is 83MB of model
            weights, and it pulls onnxruntime (93MB) and the DJL HuggingFace tokenizer (19MB)
            behind it - roughly 200MB, which lands in the week 4 Docker image. The tokenizer's
            native libraries for win-x86_64 are bundled inside its jar rather than fetched on
            first use, which is what keeps the whole thing offline.

            A "-q" quantized variant of the model exists and is far smaller, at some cost in
            quality. Worth revisiting if image size becomes the problem; not before.
        -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-embeddings-all-minilm-l6-v2</artifactId>
            <version>${langchain4j-embeddings.version}</version>
        </dependency>

        <!--
            Loads .env into the Spring Environment. Note: as of 5.x this library no
            longer self-registers (no spring.factories), so DotenvApplicationInitializer
            is registered explicitly in IncidentResponderApplication.main.
        -->
        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>spring-dotenv</artifactId>
            <version>${spring-dotenv.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        Tests tagged "llm" make real, billable calls to Groq. Keeping them out
                        of the build means `mvn test` stays fast, free and offline. Running
                        one directly from the IDE bypasses this filter, which is exactly how
                        AnalyzerBaselineTest is meant to be run. From the command line, clear
                        the property to let it through:
                          mvn test -Dsurefire.excludedGroups= -Dtest=AnalyzerBaselineTest
                    -->
                    <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
