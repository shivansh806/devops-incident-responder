# Copy to .env and fill in real values. .env is gitignored; this template is not.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Atlas: Connect > Drivers > copy the connection string, then substitute the password.
# Leave it out to fall back to a local Mongo on 27017.
# The database name is set in application.yml, so it is not needed here.
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
